#ifndef SECRETS_H
#define SECRETS_H

// Copy this file to src/secrets.h. DEVICE_ID/ZONE_ID are fallback defaults only
// (see the end of this file).
// src/secrets.h is listed in .gitignore and must never be committed,
// this repository is public (securiot2026 GitHub org).
//
// As of Phase 6 (Captive Portal / ESP32 Provisioning), WIFI_SSID,
// WIFI_PASSWORD, EDGE_API_MDNS_HOST, EDGE_API_PORT, EDGE_API_URL and
// DEVICE_KEY below are NOT read by the firmware at runtime anymore - they
// come from the captive portal (MycilaESPConnect for WiFi, the custom
// /provision-extra form for Edge API URL/device key), persisted in NVS via
// Preferences (see src/provisioning.h/.cpp). This block is kept only as
// historical documentation of the field names/shapes the portal collects.

// [PORTAL-MANAGED, no longer read from secrets.h at runtime]
#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// Set to 1 for a viewer/snapshots/status on port 80 and MJPEG on port 81.
// Disables device-initiated Edge uploads and servo initialization.
// Unauthenticated: use only on a trusted private LAN.
#define CAMERA_PREVIEW_ONLY 0

// [PORTAL-MANAGED, no longer read from secrets.h at runtime]
// mDNS-based Edge API discovery stays out of scope for this phase (see
// .planning/phases/06-captive-portal-esp32-provisioning/06-CONTEXT.md) -
// EDGE_API_MDNS_HOST/EDGE_API_PORT are documentation-only, unused.
#define EDGE_API_MDNS_HOST "edge-api"

// [PORTAL-MANAGED, no longer read from secrets.h at runtime]
#define EDGE_API_PORT   5000

// [PORTAL-MANAGED, no longer read from secrets.h at runtime]
// Field shape only - the actual value now comes from the /provision-extra
// form, submitted through the portal and stored in Preferences.
#define EDGE_API_URL    "http://192.168.1.50:5000"

// [PORTAL-MANAGED, no longer read from secrets.h at runtime]
// Field shape only - the actual value now comes from the /provision-extra
// form, submitted through the portal and stored in Preferences.
#define DEVICE_KEY      "replace-with-real-device-key"

// FALLBACK DEFAULTS ONLY. The Device id (Cloud Device UUID) and Zone id sent
// as multipart fields on every /frames request now come from the captive
// portal's /provision-extra form, stored in NVS (see docs/BRINGUP.md). These
// two constants are used only when NVS holds no valid portal-provided
// identity, for example a device provisioned before this change. Keep them
// defined so existing local secrets.h files still compile.
#define DEVICE_ID       "esp32cam-01"
#define ZONE_ID         "zone-01"

#endif // SECRETS_H
