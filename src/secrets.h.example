#ifndef SECRETS_H
#define SECRETS_H

// Copy this file to src/secrets.h and fill in real values.
// src/secrets.h is listed in .gitignore and must never be committed,
// regardless of this repository's visibility.

#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// Set to 1 for a viewer/snapshots/status on port 80 and MJPEG on port 81.
// Disables device-initiated Edge uploads and servo initialization.
// Unauthenticated: use only on a trusted private LAN.
#define CAMERA_PREVIEW_ONLY 0

// mDNS hostname of the machine running the Edge API, WITHOUT ".local".
// If that machine advertises itself as "edge-api.local" on the LAN (see
// securiot-edge-api/README.md, "LAN discovery (mDNS)"), the firmware finds
// it automatically at boot and after connection failures, no IP needed.
// Comment this line out to disable mDNS lookup and always use the static
// EDGE_API_URL below instead.
#define EDGE_API_MDNS_HOST "edge-api"

// Port the Edge API listens on. Used together with EDGE_API_MDNS_HOST once
// mDNS resolves an IP, and alone if EDGE_API_MDNS_HOST is not defined.
#define EDGE_API_PORT   5000

// Static fallback base URL, no trailing slash, used when EDGE_API_MDNS_HOST
// is not defined, or mDNS resolution fails (e.g. "http://192.168.1.50:5000").
#define EDGE_API_URL    "http://192.168.1.50:5000"

// Shared secret sent as the X-Device-Key header on every /frames request,
// must match a device key configured on the Edge API.
#define DEVICE_KEY      "replace-with-real-device-key"

// Identifiers sent as multipart fields on every /frames request.
#define DEVICE_ID       "esp32cam-01"
#define ZONE_ID         "zone-01"

#endif // SECRETS_H
